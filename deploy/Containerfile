# --- build: compile TypeScript (src/ → dist/) with the dev dependencies ---
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && rm -rf /root/.npm
COPY tsconfig.json ./
COPY public/types.js public/trainer-sprites.js public/trainer-variants.js public/shop.js public/radio.js public/upstream.js ./public/
COPY src ./src
RUN npm run build

# --- runtime: production dependencies, compiled code, data and assets ---
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && rm -rf /root/.npm
# The battle animations are converted, and the trainers cropped and recolored, at build time (the
# server has no egress). Sprites, cries, sounds and music load from jsDelivr in the browser.
COPY scripts/sync-battle-anims.js scripts/upstream-files.js ./scripts/
COPY public/music.js public/battle-anims.js public/radio.js public/shop.js public/trainer-sprites.js public/trainer-variants.js public/upstream.js ./public/
COPY public/upstream/pokerogue.json ./public/upstream/pokerogue.json
COPY src/catalog/data/movedex.json ./src/catalog/data/movedex.json
RUN node scripts/sync-battle-anims.js
COPY scripts/sync-trainers.js ./scripts/sync-trainers.js
RUN node scripts/sync-trainers.js
COPY src/catalog/data ./src/catalog/data
COPY drizzle ./drizzle
COPY public ./public
COPY --from=build /app/dist/src ./dist/src
COPY --from=build /app/dist/public ./dist/public
RUN mkdir -p /data && chown node:node /data
USER node
ENV PORT=8080 DATA_DIR=/data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
CMD ["node", "--disable-warning=ExperimentalWarning", "dist/src/main.js"]
