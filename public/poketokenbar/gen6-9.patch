+import XCTest
+@testable import PokeTokenBar
+
+final class LateGenerationsTests: XCTestCase {
+    func testEverySpeciesFromKalosToPaldeaHasAnAnimatedStrip() {
+        let ids = Set(LateGenerationSprites.strips.keys)
+        XCTAssertEqual(ids, Set(LateGenerationSprites.firstSpeciesID...PokemonAssets.animatedSpeciesIDs.upperBound))
+        for (id, strip) in LateGenerationSprites.strips {
+            XCTAssertEqual(strip.files.count, 4, "#\(id)")
+            XCTAssertEqual(strip.showdown.count, 4, "#\(id)")
+            XCTAssertGreaterThanOrEqual(strip.delays.front, 0.09, "#\(id)")
+            XCTAssertGreaterThanOrEqual(strip.delays.back, 0.09, "#\(id)")
+        }
+    }
+
+    func testGenerationFiveKeepsThePokeAPIGifs() {
+        XCTAssertNil(LateGenerationSprites.strip(speciesID: 649))
+        XCTAssertTrue(PokemonAssets.hasAnimatedSprite(speciesID: 649))
+        XCTAssertTrue(PokemonAssets.hasAnimatedSprite(speciesID: 1025))
+        XCTAssertFalse(PokemonAssets.hasAnimatedSprite(speciesID: 1026))
+    }
+
+    func testStripURLsArePinnedAndEncodeTheFolderSpace() {
+        let urls = LateGenerationSprites.stripURLs("Front shiny/CHESPIN.png").map(\.absoluteString)
+        XCTAssertEqual(urls, [
+            "https://cdn.jsdelivr.net/gh/rh-hideout-chinese/pokemon-engine@\(LateGenerationSprites.commit)/Graphics/Pokemon/Front%20shiny/CHESPIN.png",
+            "https://raw.githubusercontent.com/rh-hideout-chinese/pokemon-engine/\(LateGenerationSprites.commit)/Graphics/Pokemon/Front%20shiny/CHESPIN.png",
+        ])
+    }
+
+    func testVariantOrderMatchesTheTable() {
+        XCTAssertEqual(LateGenerationSprites.variant(shiny: false, back: false), 0)
+        XCTAssertEqual(LateGenerationSprites.variant(shiny: true, back: false), 1)
+        XCTAssertEqual(LateGenerationSprites.variant(shiny: false, back: true), 2)
+        XCTAssertEqual(LateGenerationSprites.variant(shiny: true, back: true), 3)
+    }
+
+    func testAStripBecomesALoopingGifCroppedToWhatEveryFrameShows() throws {
+        let strip = try XCTUnwrap(Self.png(Self.strip(side: 10, boxes: [CGRect(x: 2, y: 3, width: 3, height: 4),
+                                                                         CGRect(x: 4, y: 1, width: 2, height: 2)])))
+        let gif = try XCTUnwrap(StripAnimation.gif(fromStrip: strip, delay: 0.135))
+        let frames = GIFDecoder.frames(from: gif)
+        XCTAssertEqual(frames.count, 2)
+        for frame in frames {
+            XCTAssertEqual(frame.image.size, CGSize(width: 4, height: 6))
+            XCTAssertEqual(frame.delay, 0.135, accuracy: 0.011)
+        }
+        let source = try XCTUnwrap(CGImageSourceCreateWithData(gif as CFData, nil))
+        let first = try XCTUnwrap(CGImageSourceCreateImageAtIndex(source, 0, nil))
+        XCTAssertNotNil(StripAnimation.opaqueBox(first))
+        XCTAssertNotEqual(StripAnimation.opaqueBox(first)?.size, CGSize(width: 4, height: 6), "transparency survives the GIF")
+    }
+
+    func testAShinyDrawnAtSeveralTimesTheSizeShrinksToMatchItsNormal() throws {
+        let strip = try XCTUnwrap(Self.png(Self.strip(side: 16, boxes: [CGRect(x: 0, y: 0, width: 8, height: 12),
+                                                                         CGRect(x: 4, y: 4, width: 8, height: 8)])))
+        let gif = try XCTUnwrap(StripAnimation.gif(fromStrip: strip, delay: 0.09, shrink: 4))
+        let frames = GIFDecoder.frames(from: gif)
+        XCTAssertEqual(frames.first?.image.size, CGSize(width: 3, height: 3))
+        XCTAssertEqual(LateGenerationSprites.strip(speciesID: 1017)?.shinyScale.back, 4)
+        XCTAssertEqual(LateGenerationSprites.strip(speciesID: 1017)?.shinyScale.front, 1)
+    }
+
+    func testAStillStripIsNotAnAnimation() throws {
+        let still = try XCTUnwrap(Self.png(Self.strip(side: 10, boxes: [CGRect(x: 2, y: 2, width: 4, height: 4)])))
+        XCTAssertNil(StripAnimation.gif(fromStrip: still, delay: 0.09))
+    }
+
+    func testDownloadFallsBackToRawGitHubAndReportsMissingOnlyOnEvery404() async throws {
+        let strip = try XCTUnwrap(Self.png(Self.strip(side: 8, boxes: [CGRect(x: 1, y: 1, width: 2, height: 2),
+                                                                        CGRect(x: 3, y: 3, width: 2, height: 2)])))
+        var requested: [String] = []
+        let fromRaw = await LateGenerationSprites.download(speciesID: 650, shiny: false, back: false) { url in
+            requested.append(url.host() ?? "")
+            return url.host() == "raw.githubusercontent.com" ? (strip, 200) : (Data(), 503)
+        }
+        guard case .gif = fromRaw else { return XCTFail("expected a GIF, got \(fromRaw)") }
+        XCTAssertEqual(requested, ["cdn.jsdelivr.net", "raw.githubusercontent.com"])
+        let missing = await LateGenerationSprites.download(speciesID: 650, shiny: false, back: true) { _ in (Data(), 404) }
+        XCTAssertEqual(missing, .missing)
+        let offline = await LateGenerationSprites.download(speciesID: 650, shiny: false, back: true) { _ in nil }
+        XCTAssertEqual(offline, .failed)
+        let flaky = await LateGenerationSprites.download(speciesID: 650, shiny: false, back: true) { url in
+            url.host() == "cdn.jsdelivr.net" ? (Data(), 404) : nil
+        }
+        XCTAssertEqual(flaky, .failed)
+    }
+
+    func testXerneasFrontComesFromShowdownAndItsStillBackIsMissing() async throws {
+        let gif = Data([0x47, 0x49, 0x46])
+        var requested: [URL] = []
+        let front = await LateGenerationSprites.download(speciesID: 716, shiny: true, back: false) { url in
+            requested.append(url)
+            return (gif, 200)
+        }
+        XCTAssertEqual(front, .gif(gif))
+        XCTAssertEqual(requested.map(\.absoluteString), ["https://play.pokemonshowdown.com/sprites/gen5ani-shiny/xerneas.gif"])
+        let still = try XCTUnwrap(Self.png(Self.strip(side: 8, boxes: [CGRect(x: 1, y: 1, width: 2, height: 2)])))
+        let back = await LateGenerationSprites.download(speciesID: 716, shiny: false, back: true) { _ in (still, 200) }
+        XCTAssertEqual(back, .missing)
+    }
+
+    private static func strip(side: Int, boxes: [CGRect]) -> CGImage? {
+        let context = CGContext(data: nil, width: side * boxes.count, height: side, bitsPerComponent: 8,
+                                bytesPerRow: side * boxes.count * 4, space: CGColorSpaceCreateDeviceRGB(),
+                                bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue)
+        context?.setFillColor(CGColor(red: 0.8, green: 0.2, blue: 0.1, alpha: 1))
+        for (index, box) in boxes.enumerated() {
+            context?.fill(box.offsetBy(dx: CGFloat(index * side), dy: CGFloat(side) - box.maxY - box.minY))
+        }
+        return context?.makeImage()
+    }
+
+    private static func png(_ image: CGImage?) -> Data? {
+        guard let image else { return nil }
+        let output = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(output as CFMutableData, "public.png" as CFString, 1, nil) else { return nil }
+        CGImageDestinationAddImage(destination, image, nil)
+        return CGImageDestinationFinalize(destination) ? output as Data : nil
+    }
+}

From e05f16720f0e03f8b644504bebb90e5e7f916d10 Mon Sep 17 00:00:00 2001
From: Token Clash <token-clash@users.noreply.github.com>
Date: Thu, 26 Nov 2026 12:00:00 +0000
Subject: [PATCH 3/4] feat(save): graduates that stopped short of their final
 form evolve on load

A level 100 graduate whose saved chain ends at a form that now evolves (Primeape, Bisharp, Farfetch'd, ...) moves to its final form when the save loads, keeping profile and rarity, and the new final is recorded. It follows Token Clash's rule: same table of later finals, same hash of the entry id to pick one, so the app and the game show the same species. A graduate already at its final, Scizor for one, keeps its form.
---
 .../PokeTokenBar/Core/GraduateEvolution.swift | 38 ++++++++++++
 Sources/PokeTokenBar/Core/SaveTransfer.swift  |  1 +
 .../GraduateEvolutionTests.swift              | 60 +++++++++++++++++++
 3 files changed, 99 insertions(+)
 create mode 100644 Sources/PokeTokenBar/Core/GraduateEvolution.swift
 create mode 100644 Tests/PokeTokenBarTests/GraduateEvolutionTests.swift

diff --git a/Sources/PokeTokenBar/Core/GraduateEvolution.swift b/Sources/PokeTokenBar/Core/GraduateEvolution.swift
new file mode 100644
index 0000000..bc8bbb9
--- /dev/null
+++ b/Sources/PokeTokenBar/Core/GraduateEvolution.swift
@@ -0,0 +1,38 @@
+import Foundation
+
+enum GraduateEvolution {
+    static let graduatedLevel = 100
+
+    static let laterFinals: [Int: [Int]] = [
+        56: [979], 57: [979], 83: [865], 122: [866], 203: [981], 206: [982], 211: [904], 216: [901], 217: [901],
+        222: [864], 234: [899], 263: [862], 264: [862], 439: [866], 550: [902], 624: [983], 625: [983],
+    ]
+
+    static func tokenClashHash(_ text: String) -> UInt32 {
+        var value: UInt32 = 0x811c9dc5
+        for unit in text.utf16 {
+            value ^= UInt32(unit)
+            value = value &* 0x01000193
+        }
+        return value
+    }
+
+    static func evolved(_ entry: DexEntry) -> DexEntry {
+        guard !entry.isReleased, (entry.profile?.level ?? graduatedLevel) == graduatedLevel,
+              entry.chainOrder.last == entry.finalID,
+              let later = laterFinals[entry.finalID], !later.isEmpty else { return entry }
+        var evolved = entry
+        evolved.finalID = later[Int(tokenClashHash(entry.id.lowercased()) % UInt32(later.count))]
+        evolved.chainOrder.append(evolved.finalID)
+        return evolved
+    }
+
+    static func evolved(_ state: CompanionState) -> CompanionState {
+        var migrated = state
+        migrated.dex = state.dex.map(evolved)
+        for (before, after) in zip(state.dex, migrated.dex) where before.finalID != after.finalID {
+            migrated.collectedFinals.insert("\(after.baseID):\(after.finalID)")
+        }
+        return migrated
+    }
+}
