+++ b/Tests/PokeTokenBarTests/GraduateEvolutionTests.swift
@@ -0,0 +1,60 @@
+import XCTest
+@testable import PokeTokenBar
+
+final class GraduateEvolutionTests: XCTestCase {
+    func testAGraduateWhoseChainWasCutEvolvesKeepingItsProfile() {
+        var profile = PokemonProfile.generate(seed: 7, instanceID: "b")
+        profile.level = 100
+        let bisharp = DexEntry(id: "b", baseID: 624, finalID: 625, chainOrder: [624, 625], rarity: .uncommon,
+                               caughtAt: Date(timeIntervalSince1970: 1), isShiny: true, profile: profile)
+        let kingambit = GraduateEvolution.evolved(bisharp)
+        XCTAssertEqual(kingambit.finalID, 983)
+        XCTAssertEqual(kingambit.chainOrder, [624, 625, 983])
+        XCTAssertEqual(kingambit.rarity, .uncommon)
+        XCTAssertTrue(kingambit.isShiny)
+        XCTAssertEqual(kingambit.profile, profile)
+        XCTAssertTrue(kingambit.needsNamesRefresh, "the new species name is fetched like any missing name")
+        XCTAssertEqual(GraduateEvolution.evolved(kingambit).finalID, 983, "migrating twice changes nothing")
+    }
+
+    func testOnlyGraduatesAtTheEndOfTheirSavedChainEvolve() {
+        let released = DexEntry(baseID: 56, finalID: 57, chainOrder: [56, 57], rarity: .common, caughtAt: nil,
+                                releasedAt: Date(timeIntervalSince1970: 1))
+        XCTAssertEqual(GraduateEvolution.evolved(released).finalID, 57)
+        let scizor = DexEntry(baseID: 123, finalID: 212, chainOrder: [123, 212], rarity: .rare, caughtAt: nil)
+        XCTAssertEqual(GraduateEvolution.evolved(scizor).finalID, 212)
+        let odd = DexEntry(baseID: 56, finalID: 57, chainOrder: [56], rarity: .common, caughtAt: nil)
+        XCTAssertEqual(GraduateEvolution.evolved(odd).finalID, 57)
+    }
+
+    func testEveryLaterFinalIsAnAnimatedLateSpecies() {
+        for (before, after) in GraduateEvolution.laterFinals {
+            XCTAssertLessThan(before, LateGenerationSprites.firstSpeciesID)
+            for id in after { XCTAssertNotNil(LateGenerationSprites.strip(speciesID: id), "#\(before) → #\(id)") }
+        }
+    }
+
+    func testTheBranchPickMatchesTokenClashsHash() {
+        XCTAssertEqual(GraduateEvolution.tokenClashHash(""), 0x811c9dc5)
+        XCTAssertEqual(GraduateEvolution.tokenClashHash("a"), 0xe40c292c)
+        XCTAssertEqual(GraduateEvolution.tokenClashHash("3f2a9c1e-5b7d-4e8a-9c21-7d4e5f6a8b90"), 0x0212177d)
+    }
+
+    func testAGraduateBelowLevelOneHundredKeepsItsForm() {
+        var profile = PokemonProfile.generate(seed: 3, instanceID: "c")
+        profile.level = 99
+        let primeape = DexEntry(baseID: 56, finalID: 57, chainOrder: [56, 57], rarity: .common, caughtAt: nil, profile: profile)
+        XCTAssertEqual(GraduateEvolution.evolved(primeape).finalID, 57)
+    }
+
+    func testLoadingASaveEvolvesGraduatesAndCountsTheNewFinal() {
+        var state = CompanionState()
+        state.dex = [DexEntry(baseID: 56, finalID: 57, chainOrder: [56, 57], rarity: .common, caughtAt: nil),
+                     DexEntry(baseID: 1, finalID: 3, chainOrder: [1, 2, 3], rarity: .common, caughtAt: nil)]
+        state.collectedFinals = ["56:57", "1:3"]
+        let loaded = SaveTransfer.sanitized(state)
+        XCTAssertEqual(loaded.dex.map(\.finalID), [979, 3])
+        XCTAssertEqual(loaded.collectedFinals, ["56:57", "56:979", "1:3"])
+        XCTAssertEqual(SaveTransfer.sanitized(loaded).dex.map(\.finalID), [979, 3])
+    }
+}

