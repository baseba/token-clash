diff --git a/Sources/PokeTokenBar/Core/LateGenerations.swift b/Sources/PokeTokenBar/Core/LateGenerations.swift
new file mode 100644
index 0000000..7478705
--- /dev/null
+++ b/Sources/PokeTokenBar/Core/LateGenerations.swift
@@ -0,0 +1,128 @@
+import CoreGraphics
+import Foundation
+import ImageIO
+import UniformTypeIdentifiers
+
+enum LateGenerationSprites {
+    struct Strip: Sendable {
+        let files: [String]
+        let delays: (front: TimeInterval, back: TimeInterval)
+        var shinyScale: (front: Int, back: Int) = (1, 1)
+        var showdown: [String?] = [nil, nil, nil, nil]
+    }
+
+    enum Download: Equatable {
+        case gif(Data)
+        case missing
+        case failed
+    }
+
+    static let firstSpeciesID = 650
+    static let repo = "rh-hideout-chinese/pokemon-engine"
+    static let commit = "4d4eb60502cf2b347d30d68100f3ef5b54c97c2f"
+    static let pokemonDirectory = "Graphics/Pokemon/"
+
+    static func strip(speciesID: Int) -> Strip? { strips[speciesID] }
+
+    static func variant(shiny: Bool, back: Bool) -> Int { (back ? 2 : 0) + (shiny ? 1 : 0) }
+
+    static func stripURLs(_ file: String) -> [URL] {
+        let path = (pokemonDirectory + file).split(separator: "/")
+            .map { $0.addingPercentEncoding(withAllowedCharacters: .urlPathAllowed) ?? String($0) }
+            .joined(separator: "/")
+        return ["https://cdn.jsdelivr.net/gh/\(repo)@\(commit)/\(path)",
+                "https://raw.githubusercontent.com/\(repo)/\(commit)/\(path)"].compactMap(URL.init(string:))
+    }
+
+    static func download(speciesID: Int, shiny: Bool, back: Bool) async -> Download {
+        await download(speciesID: speciesID, shiny: shiny, back: back, fetch: liveFetch)
+    }
+
+    static func download(speciesID: Int, shiny: Bool, back: Bool,
+                         fetch: (URL) async -> (Data, Int)?) async -> Download {
+        guard let strip = strip(speciesID: speciesID) else { return .missing }
+        let variant = variant(shiny: shiny, back: back)
+        if let showdown = strip.showdown[variant], let url = URL(string: showdown) {
+            guard let (data, status) = await fetch(url) else { return .failed }
+            return status == 200 && !data.isEmpty ? .gif(data) : status == 404 ? .missing : .failed
+        }
+        var notFound = true
+        for url in stripURLs(strip.files[variant]) {
+            guard let (data, status) = await fetch(url) else { notFound = false; continue }
+            guard status == 200, !data.isEmpty else { notFound = notFound && status == 404; continue }
+            let delay = back ? strip.delays.back : strip.delays.front
+            let shrink = shiny ? (back ? strip.shinyScale.back : strip.shinyScale.front) : 1
+            return StripAnimation.gif(fromStrip: data, delay: delay, shrink: shrink).map(Download.gif) ?? .missing
+        }
+        return notFound ? .missing : .failed
+    }
+
+    static func liveFetch(_ url: URL) async -> (Data, Int)? {
+        guard let (data, response) = try? await URLSession.shared.data(from: url) else { return nil }
+        return (data, (response as? HTTPURLResponse)?.statusCode ?? 0)
+    }
+}
+
+enum StripAnimation {
+    static func frames(fromStrip data: Data) -> [CGImage] {
+        guard let source = CGImageSourceCreateWithData(data as CFData, nil),
+              let strip = CGImageSourceCreateImageAtIndex(source, 0, nil),
+              strip.height > 0 else { return [] }
+        let side = strip.height
+        let count = strip.width / side
+        guard count > 1 else { return [] }
+        let tiles = (0..<count).compactMap { strip.cropping(to: CGRect(x: $0 * side, y: 0, width: side, height: side)) }
+        let boxes = tiles.compactMap { opaqueBox($0) }
+        guard let first = boxes.first else { return tiles }
+        let box = boxes.dropFirst().reduce(first) { $0.union($1) }
+        return tiles.compactMap { $0.cropping(to: box) }
+    }
+
+    static func gif(fromStrip data: Data, delay: TimeInterval, shrink factor: Int = 1) -> Data? {
+        let frames = frames(fromStrip: data)
+        guard frames.count > 1 else { return nil }
+        return gif(frames: factor > 1 ? frames.compactMap { shrink($0, by: factor) } : frames, delay: delay)
+    }
+
+    static func shrink(_ image: CGImage, by factor: Int) -> CGImage? {
+        let width = max(1, image.width / factor), height = max(1, image.height / factor)
+        guard let context = CGContext(data: nil, width: width, height: height, bitsPerComponent: 8,
+                                      bytesPerRow: width * 4, space: CGColorSpaceCreateDeviceRGB(),
+                                      bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue) else { return nil }
+        context.interpolationQuality = .none
+        context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
+        return context.makeImage()
+    }
+
+    static func gif(frames: [CGImage], delay: TimeInterval) -> Data? {
+        let output = NSMutableData()
+        guard let destination = CGImageDestinationCreateWithData(output as CFMutableData, UTType.gif.identifier as CFString,
+                                                                  frames.count, nil) else { return nil }
+        let loop = [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFLoopCount: 0]]
+        CGImageDestinationSetProperties(destination, loop as CFDictionary)
+        let timing = [kCGImagePropertyGIFDictionary: [kCGImagePropertyGIFDelayTime: delay,
+                                                      kCGImagePropertyGIFUnclampedDelayTime: delay]]
+        for frame in frames { CGImageDestinationAddImage(destination, frame, timing as CFDictionary) }
+        guard CGImageDestinationFinalize(destination) else { return nil }
+        return output as Data
+    }
+
+    static func opaqueBox(_ image: CGImage) -> CGRect? {
+        let width = image.width, height = image.height
+        guard let context = CGContext(data: nil, width: width, height: height, bitsPerComponent: 8,
+                                      bytesPerRow: width * 4, space: CGColorSpaceCreateDeviceRGB(),
+                                      bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue),
+              let buffer = context.data else { return nil }
+        context.draw(image, in: CGRect(x: 0, y: 0, width: width, height: height))
+        let pixels = buffer.bindMemory(to: UInt8.self, capacity: width * height * 4)
+        var minX = width, minY = height, maxX = -1, maxY = -1
+        for row in 0..<height {
+            for column in 0..<width where pixels[(row * width + column) * 4 + 3] > 0 {
+                minX = min(minX, column); maxX = max(maxX, column)
+                minY = min(minY, row); maxY = max(maxY, row)
+            }
+        }
+        guard maxX >= minX else { return nil }
+        return CGRect(x: minX, y: minY, width: maxX - minX + 1, height: maxY - minY + 1)
+    }
+}
