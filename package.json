{
  "name": "token-clash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "dev": "tsc -p tsconfig.json && (tsc -p tsconfig.json --watch --preserveWatchOutput & node --disable-warning=ExperimentalWarning --watch dist/src/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && node --disable-warning=ExperimentalWarning --test --test-timeout=120000 'dist/src/**/*.spec.js' 'dist/test/*.e2e-spec.js' 'test/web/*.test.js'",
    "db:generate": "drizzle-kit generate",
    "sprites": "node scripts/sprites.mjs",
    "cries": "node scripts/sync-cries.js",
    "anims": "node scripts/sync-battle-anims.js",
    "postinstall": "(node scripts/sprites.mjs || echo 'No se pudieron descargar los sprites: corre npm run sprites cuando tengas conexión.') && (node scripts/sync-cries.js || echo 'No se pudieron descargar los gritos: corre npm run cries cuando tengas conexión.') && (node scripts/sync-battle-anims.js || echo 'No se pudieron descargar las animaciones: corre npm run anims cuando tengas conexión.')"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/platform-ws": "12.3.2",
    "@nestjs/websockets": "12.3.2",
    "drizzle-orm": "1.0.0-rc.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.5",
    "typescript": "~6.0.3"
  }
}
