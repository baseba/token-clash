{
  // Unit tests live next to the code they test (src/**/*.spec.ts) and the e2e tests in test/
  // (*.e2e-spec.ts). tsconfig.json leaves them out of the app build; this one compiles everything.
  // Tests build half-made fixtures (a Pokémon with only the fields a rule reads), so they compile
  // with looser checks than src/, which tsconfig.json keeps strict.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "tsBuildInfoFile": "./dist/.tsbuildinfo.test"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "public/types.js", "public/trainer-sprites.js", "public/shop.js", "public/trainer-variants.js"],
  "exclude": ["node_modules", "dist"]
}
